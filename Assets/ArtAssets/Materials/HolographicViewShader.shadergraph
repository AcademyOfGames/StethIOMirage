{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "270b789e7e554b8eb4b6e69799b94da9",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "ParallaxLoop (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1196.0001220703125,
            "y": 1239.0001220703125,
