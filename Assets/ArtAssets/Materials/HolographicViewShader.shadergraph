        {
            "m_Id": "b080dc6085794ba08eb52cb0d21f7ba0"
        },
        {
            "m_Id": "ec7caf67d34b45d883cd58b9a68cc2e2"
        },
        {
            "m_Id": "dec4adcb2ac1480ea81ba5a2245bb0ae"
        },
        {
            "m_Id": "3667cecb45dd410ba7299a9e504795d6"
        },
        {
            "m_Id": "2806455adba244278e4cad44ee7078e4"
        },
        {
            "m_Id": "f49c33d3c5dc497fab715b4fe174344d"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "ParallaxLoop",
    "m_FunctionSource": "",
    "m_FunctionBody": "float4 result = float4(1,1,1,1);\nfloat BW = 0;\nfloat totalOffset = 0;\n\ntotalOffset += parallax;\nfloat2 offset = float2((ViewDirection * totalOffset).r, (ViewDirection * totalOffset).g);\nBW = SAMPLE_TEXTURE2D(Mask, SS, (UV+offset)).r;\nresult *= clamp(BW,0,1);\n\nresult.a = 1;\nOut = result;"
}

